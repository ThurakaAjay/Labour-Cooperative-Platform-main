# ===============================================================
# WORKHIVE — ENVIRONMENT CONFIGURATION
# ===============================================================

# Server Port
PORT=5000

# Node Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String (e.g., MongoDB Atlas or local daemon)
# In production, a valid MongoDB URI is strictly required.
MONGODB_URI=mongodb://127.0.0.1:27017/workhive

# In-Memory DB Fallback (development/testing only; strictly disabled in production)
ALLOW_IN_MEMORY_DB=true

# JWT Secret for Signing and Verifying Authentication Tokens (CHANGE IN PRODUCTION)
JWT_SECRET=workhive_cooperative_secret_key_2026

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173


# Single Admin Account (auto-created in MongoDB on server boot if no admin exists yet).
# Public self-registration as 'admin' is disabled — this is the only way an admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_PHONE=9999999999

# ===============================================================
# CLOUDINARY (Booking / Emergency photo uploads)
# Get these from https://cloudinary.com/console — free tier available.
# Photo upload endpoints return 503 until all three are set.
# ===============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===============================================================
# RAZORPAY (Payment gateway — test mode keys from https://dashboard.razorpay.com/app/keys)
# Payment endpoints return 503 until both key vars are set.
# ===============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set under Razorpay Dashboard > Settings > Webhooks when configuring the
# payment.captured / payment.failed webhook URL; required to verify webhook calls.
RAZORPAY_WEBHOOK_SECRET=
