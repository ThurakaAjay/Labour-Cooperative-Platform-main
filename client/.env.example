# ===============================================================
# WORKHIVE CLIENT — ENVIRONMENT CONFIGURATION
# ===============================================================

# Base URL for the WorkHive backend API.
# In local development with Vite proxy, leave empty or set to '/api'.
# In standalone production deployment (e.g. Vercel/Netlify pointing to external API),
# set to the full URL (e.g. 'https://api.workhive.coop/api').
VITE_API_URL=/api
