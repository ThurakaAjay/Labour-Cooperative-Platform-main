# ===============================================================
# WORKHIVE — PRODUCTION ENVIRONMENT CONFIGURATION
# Set these environment variables in your cloud hosting provider:
# (Render / Railway / Fly.io / AWS / Heroku / Docker)
# ===============================================================

# 1. Server Environment & Networking
NODE_ENV=production
PORT=5000

# 2. Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workhive?retryWrites=true&w=majority
MONGODB_URI=

# 3. Security & Authentication
# Strong random string used to sign JWT session tokens (at least 32 characters)
JWT_SECRET=

# 4. Initial Administrator Account
# Automatically seeded on first boot if no admin exists yet.
# Public self-registration as admin is disabled for security.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_PHONE=9999999999

# 5. Cloudinary Storage (Customer & Worker Photo Uploads)
# Get credentials from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. CORS Whitelist
# Optional for unified deployments (same-domain). Required for decoupled deployments.
# Comma-separated list of allowed origins.
# Example: https://workhive.vercel.app,https://workhive.onrender.com
CORS_ORIGIN=

# 7. Razorpay Payment Gateway (Optional - for live payments)
# Leave blank or commented if payments are not yet enabled.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
